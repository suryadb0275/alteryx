# Copy this file to `.env` (same folder you run the command from) and fill it in. `.env` is git-ignored: never commit a token.
# Real environment variables win over this file. Inside a Databricks notebook none of this is needed (it uses your own sign-in).

# Your workspace URL (also used to find the AI Gateway: <host>/ai-gateway/mlflow/v1)
DATABRICKS_HOST=https://dbc-11cf3253-4503.cloud.databricks.com

# A personal access token: Databricks > Settings > Developer > Access tokens > Generate new token.
# Only needed for --model. Leave it out to use `databricks auth login` (CLI profile) instead.
DATABRICKS_TOKEN=

# Optional: a Databricks CLI profile to sign in with instead of a token
# DATABRICKS_CONFIG_PROFILE=imsuryya

# Optional: where the converted notebooks read and write tables. Leave both empty and the table names are not qualified:
# the notebooks use the catalog and schema that are current when they run. (--catalog / --schema on the command line win.)
CATALOG=
SCHEMA=

# Optional: the Databricks model that writes what the rules cannot convert (a serving endpoint / AI Gateway name; see `python -m alteryx_migrate models`). --model wins.
MODEL=
