    <!-- C: recursive Multi-Row Formula with one [Row-1:f] result (Production Data [46]); CReW Record ID macro removed after a Filter (ONBItaly [160]) -->
    <Node ToolID="20">
      <GuiSettings Plugin="AlteryxBasePluginsGui.TextInput.TextInput">
        <Position x="100" y="600" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <NumRows value="6" />
          <Fields>
            <Field name="G" />
            <Field name="Seq" type="Int32" />
            <Field name="Last" type="Int32" />
            <Field name="Day" type="Int32" />
            <Field name="Plan" type="Double" />
          </Fields>
          <Data>
            <r><c>a</c><c>1</c><c>30</c><c>30</c><c>9</c></r>
            <r><c>a</c><c>2</c><c>30</c><c>10</c><c>5</c></r>
            <r><c>a</c><c>3</c><c>30</c><c>30</c><c>7</c></r>
            <r><c>a</c><c>4</c><c>30</c><c>30</c><c>8</c></r>
            <r><c>a</c><c>5</c><c>30</c><c>31</c><c>4</c></r>
            <r><c>b</c><c>1</c><c>30</c><c>12</c><c>6</c></r>
          </Data>
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxTextInput" />
    </Node>
    <Node ToolID="21">
      <GuiSettings Plugin="AlteryxBasePluginsGui.MultiRowFormula.MultiRowFormula">
        <Position x="200" y="600" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <UpdateField value="True" />
          <UpdateField_Name>Plan</UpdateField_Name>
          <CreateField_Name>New Field</CreateField_Name>
          <CreateField_Type>Int32</CreateField_Type>
          <CreateField_Size>4</CreateField_Size>
          <OtherRows>Empty</OtherRows>
          <NumRows value="1" />
          <Expression>if ([Last] &gt; [Day]) then [Plan]
elseif ([Last] = [Day]) then [Row-1:Plan]
else 0
endif</Expression>
          <GroupByFields>
            <Field field="G" />
          </GroupByFields>
        </Configuration>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxMultiRowFormula" />
    </Node>
