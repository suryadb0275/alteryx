            <Field name="ID" />
            <Field name="Code" />
            <Field name="Dt" />
            <Field name="KPI" />
          </Fields>
          <Data>
            <r><c>1</c><c>a-b-c</c><c>2024-03-17</c><c>9</c></r>
            <r><c>2</c><c>x-y</c><c>2024-12-31</c><c>0</c></r>
            <r><c>3</c><c>p</c><c>2023-01-01</c><c>KPI7</c></r>
